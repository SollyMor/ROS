<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">
  <!-- Dimensions from course_ackermann SDF. SI units, REP-103: x forward, y left, z up.
       Gazebo plugins are not copied; this file is the ROS description. -->

  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="track" value="0.62"/>
  <xacro:property name="wheel_base" value="0.80"/>
  <xacro:property name="half_track" value="${track / 2.0}"/>
  <xacro:property name="half_wheel_base" value="${wheel_base / 2.0}"/>
  <xacro:property name="sensor_x" value="0.28"/>
  <xacro:property name="sensor_z" value="0.38"/>
  <xacro:property name="body_mass" value="12.0"/>
  <xacro:property name="knuckle_mass" value="0.2"/>

  <!-- Cylinder spin axis is Y after a +90 deg roll, so Iyy is the axle moment. -->
  <xacro:property name="wheel_iyy" value="${0.5 * wheel_mass * wheel_radius * wheel_radius}"/>
  <xacro:property name="wheel_ixx" value="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"/>

  <material name="body_blue">
    <color rgba="0.05 0.36 0.72 1"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.04 0.04 0.04 1"/>
  </material>
  <material name="camera_green">
    <color rgba="0.1 0.7 0.2 1"/>
  </material>
  <material name="lidar_orange">
    <color rgba="0.9 0.4 0.05 1"/>
  </material>
  <material name="imu_yellow">
    <color rgba="0.9 0.85 0.1 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="0.55" ixy="0" ixz="0" iyy="1.10" iyz="0" izz="1.40"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="1.05 0.52 0.22"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="1.05 0.52 0.22"/>
      </geometry>
    </collision>
  </link>

  <xacro:macro name="knuckle" params="name">
    <link name="${name}">
      <inertial>
        <mass value="${knuckle_mass}"/>
        <inertia
          ixx="${knuckle_mass * (0.04 * 0.04 + 0.06 * 0.06) / 12.0}"
          ixy="0" ixz="0"
          iyy="${knuckle_mass * (0.04 * 0.04 + 0.06 * 0.06) / 12.0}"
          iyz="0"
          izz="${knuckle_mass * (0.04 * 0.04 + 0.04 * 0.04) / 12.0}"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.04 0.04 0.06"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.04 0.04 0.06"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="wheel" params="name parent x y">
    <link name="${name}">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_ixx}" ixy="0" ixz="0"
          iyy="${wheel_iyy}" iyz="0"
          izz="${wheel_ixx}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="front_corner" params="side sign">
    <xacro:knuckle name="front_${side}_knuckle"/>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_knuckle"/>
      <origin xyz="${half_wheel_base} ${sign * half_track} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.55" upper="0.55" effort="25" velocity="1.0"/>
    </joint>
    <xacro:wheel
      name="front_${side}_wheel"
      parent="front_${side}_knuckle"
      x="0" y="0"/>
  </xacro:macro>

  <xacro:front_corner side="left" sign="1.0"/>
  <xacro:front_corner side="right" sign="-1.0"/>
  <xacro:wheel name="rear_left_wheel" parent="base_link" x="${-half_wheel_base}" y="${half_track}"/>
  <xacro:wheel name="rear_right_wheel" parent="base_link" x="${-half_wheel_base}" y="${-half_track}"/>

  <xacro:macro name="sensor_box" params="name material">
    <link name="${name}">
      <inertial>
        <mass value="0.04"/>
        <inertia
          ixx="${0.04 * (0.05 * 0.05 + 0.03 * 0.03) / 12.0}"
          ixy="0" ixz="0"
          iyy="${0.04 * (0.04 * 0.04 + 0.03 * 0.03) / 12.0}"
          iyz="0"
          izz="${0.04 * (0.04 * 0.04 + 0.05 * 0.05) / 12.0}"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.04 0.05 0.03"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.04 0.05 0.03"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:sensor_box name="camera_link" material="camera_green"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <!-- REP-103 optical frame: z forward, x right, y down. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  </joint>

  <xacro:sensor_box name="lidar_link" material="lidar_orange"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
  </joint>

  <xacro:sensor_box name="imu_link" material="imu_yellow"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
  </joint>
</robot>
